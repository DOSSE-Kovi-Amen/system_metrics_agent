# Dockerfile.dev — environnement de développement
# Image de confort : dépendances complètes (incl. pytest), rechargement à chaud.

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Dépendances (dev + test)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Utilisateur non-root
RUN useradd --create-home --uid 1000 appuser

# Le code applicatif est copié ici pour permettre un `docker run` autonome ;
# en pratique docker-compose.override.yml monte ./app en volume par-dessus
# pour le rechargement à chaud (--reload).
COPY . .
RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

# Commande par défaut : l'API en mode --reload.
# Le service "agent" écrase cette commande via docker-compose.override.yml.
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
